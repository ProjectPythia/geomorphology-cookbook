ineCode","value":"azimuth","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JbdvZfzgxp"},{"type":"text","value":" is the compass direction of the light and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vxkX0EYGEE"},{"type":"inlineCode","value":"angle_altitude","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aN0M90aMnw"},{"type":"text","value":" is its height above the horizon.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PWutulDwO0"}],"key":"lOp0h5E0a0"}],"key":"Ftcuk6s6eK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"shaded = hillshade(bathy, azimuth=315, angle_altitude=45)\n\nfig, ax = plt.subplots(figsize=(10, 8), constrained_layout=True)\nshaded.plot(ax=ax, cmap=\"gray\", add_colorbar=False)\nax.set_title(\"Gifford hillshade\")\nax.set_xlabel(\"Easting\")\nax.set_ylabel(\"Northing\")\nax.set_aspect(\"equal\")\nax.xaxis.set_major_formatter(formatter)\nax.yaxis.set_major_formatter(formatter)\nplt.show()","key":"kkLycvKs2S"},{"type":"outputs","id":"kvLuzgof33S26PYlhdcct","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x800 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"41cf9898fd4c06e89fcc9b4279c0666a","path":"/geomorphology-cookbook/build/41cf9898fd4c06e89fcc9b4279c0666a.png"}}},"key":"k5WhgpTwer"}],"key":"Ga7MVB2RiX"}],"key":"LLjoecPbHX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Color-shaded relief","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZPb3gxaFZv"}],"identifier":"color-shaded-relief","label":"Color-shaded relief","html_id":"color-shaded-relief","implicit":true,"key":"uXU8OSSiEs"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The most informative view overlays the depth colormap on the shaded relief. Matplotlib’s ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aV1hG6D6by"},{"type":"inlineCode","value":"LightSource.shade","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dzluoXXDFI"},{"type":"text","value":" blends a colormap with illumination in a single call. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BumIRLunSK"},{"type":"inlineCode","value":"vert_exag","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fFRljmykwK"},{"type":"text","value":" exaggerates the vertical relief, useful for the gentle gradients of the seafloor. Because the blended image is an RGB array, we build a matching colorbar from a ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WWuzA8kQrX"},{"type":"inlineCode","value":"ScalarMappable","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"inwHdhWlal"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"B2Ezg0KuPi"}],"key":"MvM4ZICXca"}],"key":"K5fjfneHQr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ls = LightSource(azdeg=315, altdeg=45)\ndx, dy = bathy.rio.resolution()\n\nrgb = ls.shade(\n    bathy.values,\n    cmap=plt.cm.viridis,\n    vert_exag=5,\n    dx=abs(dx),\n    dy=abs(dy),\n    blend_mode=\"soft\",\n)\n\n# Map-coordinate extent for imshow: (left, right, bottom, top)\nleft, bottom, right, top = bathy.rio.bounds()\n\nfig, ax = plt.subplots(figsize=(10, 8), constrained_layout=True)\nax.imshow(rgb, extent=(left, right, bottom, top), origin=\"upper\")\n\nnorm = Normalize(vmin=float(bathy.min()), vmax=float(bathy.max()))\ncbar = fig.colorbar(ScalarMappable(norm=norm, cmap=\"viridis\"), ax=ax, shrink=0.85)\ncbar.set_label(\"Bathymetry (m)\")\n\nax.set_title(\"Gifford color-shaded relief\")\nax.set_xlabel(\"Easting\")\nax.set_ylabel(\"Northing\")\nax.xaxis.set_major_formatter(formatter)\nax.yaxis.set_major_formatter(formatter)\nplt.show()","key":"DFOFcZnxJu"},{"type":"outputs","id":"FZraz8E4if7aaIenD0KvB","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x800 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"960894eeb5d0b3b5e3585e7cecffdfff","path":"/geomorphology-cookbook/build/960894eeb5d0b3b5e3585e7cecffdfff.png"}}},"key":"KMynRhKrH4"}],"key":"nUiTm63CMe"}],"key":"HVVy4fZsnE"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"important","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"The two shading sections are alternatives","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dZoxZtQPvH"}],"key":"Car0g74itY"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"i17MKiKrTe"},{"type":"inlineCode","value":"xarray-spatial","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ug3oN1sUwW"},{"type":"text","value":" hillshade and this ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"XQ6O6ba7k5"},{"type":"inlineCode","value":"LightSource","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AEomnrncJd"},{"type":"text","value":" view are two separate ways to render relief, not a chain. ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Z6Ui5Pz6Id"},{"type":"inlineCode","value":"LightSource.shade","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"i3ZbdyRtOR"},{"type":"text","value":" computes its own hillshade internally and blends it with the colormap, so the earlier ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"uChpztRnw3"},{"type":"inlineCode","value":"shaded","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"R11F7SXIFa"},{"type":"text","value":" array is not an input here. Reach for ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"HnTLTb2Gr6"},{"type":"inlineCode","value":"xarray-spatial","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"j2kaQ8v3HU"},{"type":"text","value":"’s ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SvrPNSnh5p"},{"type":"inlineCode","value":"hillshade","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"I8QXCXFlGa"},{"type":"text","value":" when you need the relief as reusable data, such as saving it as its own raster or scaling across large Dask-backed arrays; reach for ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"qAeaw2GlcM"},{"type":"inlineCode","value":"LightSource.shade","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Cd6dEZblal"},{"type":"text","value":" when you just want the finished color-and-relief figure.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"P4cA6uT7UE"}],"key":"m8X7UF2E4l"}],"key":"K24Y4aewcD"}],"key":"Xbl2u3gydJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A reusable function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QySFyHurfT"}],"identifier":"a-reusable-function","label":"A reusable function","html_id":"a-reusable-function","implicit":true,"key":"vGXyV17drQ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The same three steps, load, shade, and plot, apply to any single-band bathymetry raster. We wrap them in one function and apply it to a second survey, Point Cloates.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pAhCdA7vOG"}],"key":"L0G5vifZb4"}],"key":"lnFsPnDCr3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def plot_shaded_relief(path, title, azimuth=315, altitude=45, vert_exag=5, cmap=\"viridis\"):\n    \"\"\"Load a single-band raster with rioxarray and plot color-shaded relief.\"\"\"\n    da = rioxarray.open_rasterio(path, masked=True).squeeze()\n\n    ls = LightSource(azdeg=azimuth, altdeg=altitude)\n    dx, dy = da.rio.resolution()\n    rgb = ls.shade(\n        da.values, cmap=plt.get_cmap(cmap), vert_exag=vert_exag,\n        dx=abs(dx), dy=abs(dy), blend_mode=\"soft\",\n    )\n\n    left, bottom, right, top = da.rio.bounds()\n    fig, ax = plt.subplots(figsize=(9, 7), constrained_layout=True)\n    ax.imshow(rgb, extent=(left, right, bottom, top), origin=\"upper\")\n\n    norm = Normalize(vmin=float(da.min()), vmax=float(da.max()))\n    cbar = fig.colorbar(ScalarMappable(norm=norm, cmap=cmap), ax=ax, shrink=0.85)\n    cbar.set_label(\"Bathymetry (m)\")\n\n    ax.set_title(title)\n    ax.set_xlabel(\"Easting (m)\")\n    ax.set_ylabel(\"Northing (m)\")\n    ax.xaxis.set_major_formatter(formatter)\n    ax.yaxis.set_major_formatter(formatter)\n    return da","key":"qxtxrAc3yW"},{"type":"outputs","id":"W7HuTlk6HcLzRGMW7QhMJ","children":[],"key":"GGN0CkIc1W"}],"key":"x3RBud7PyY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Applying to another survey","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SYK2zJE1QT"}],"identifier":"applying-to-another-survey","label":"Applying to another survey","html_id":"applying-to-another-survey","implicit":true,"key":"OXPAHhQR4b"}],"key":"XkkZ1TKnaK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"pc_bathy = plot_shaded_relief(\"../data/pc_bathy.tif\", \"Point Cloates color-shaded relief\")\nplt.show()","key":"UsiUAA8cAH"},{"type":"outputs","id":"DVZMhl1CVP-40QMaJVk6v","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 900x700 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"7282a2e7bd69a2a09afe7166755a395f","path":"/geomorphology-cookbook/build/7282a2e7bd69a2a09afe7166755a395f.png"}}},"key":"ALvU2mWPDy"}],"key":"xWlg7euuHv"}],"key":"tdfKBVbESo"}],"key":"mfmmRVvyRA"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introduction to rasterio","url":"/notebooks/rasterio-intro","group":"Introduction"},"next":{"title":"Metadata and resources for the data story","url":"/notebooks/metadata","group":"Data story"}}},"domain":"http://localhost:3000"}