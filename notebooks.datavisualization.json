,"implicit":true,"key":"YYvc6pIpyS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The most informative view overlays the depth colormap on the shaded relief. Matplotlib’s ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XfTuA1cmHm"},{"type":"inlineCode","value":"LightSource.shade","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EWHR5aBt1f"},{"type":"text","value":" blends a colormap with illumination in a single call. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pZD1663ESq"},{"type":"inlineCode","value":"vert_exag","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"b1jDykgxBW"},{"type":"text","value":" exaggerates the vertical relief, useful for the gentle gradients of the seafloor. Because the blended image is an RGB array, we build a matching colorbar from a ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WKemSdbAIo"},{"type":"inlineCode","value":"ScalarMappable","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qYYFHH272T"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"t9X9Fy5ReX"}],"key":"R2LQFMy1Jh"}],"key":"UCKwQWQaM9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ls = LightSource(azdeg=315, altdeg=45)\ndx, dy = bathy.rio.resolution()\n\nrgb = ls.shade(\n    bathy.values,\n    cmap=plt.cm.viridis,\n    vert_exag=5,\n    dx=abs(dx),\n    dy=abs(dy),\n    blend_mode=\"soft\",\n)\n\n# Map-coordinate extent for imshow: (left, right, bottom, top)\nleft, bottom, right, top = bathy.rio.bounds()\n\nfig, ax = plt.subplots(figsize=(10, 8), constrained_layout=True)\nax.imshow(rgb, extent=(left, right, bottom, top), origin=\"upper\")\n\nnorm = Normalize(vmin=float(bathy.min()), vmax=float(bathy.max()))\ncbar = fig.colorbar(ScalarMappable(norm=norm, cmap=\"viridis\"), ax=ax, shrink=0.85)\ncbar.set_label(\"Bathymetry (m)\")\n\nax.set_title(\"Gifford color-shaded relief\")\nax.set_xlabel(\"Easting\")\nax.set_ylabel(\"Northing\")\nax.xaxis.set_major_formatter(formatter)\nax.yaxis.set_major_formatter(formatter)\nplt.show()","key":"et8olOmUJL"},{"type":"outputs","id":"zovNxZ6ck5nDS6ndAmLWd","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x800 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"2234e0ba969bcc794ac5a1f0a6038eaf","path":"/geomorphology-cookbook/build/2234e0ba969bcc794ac5a1f0a6038eaf.png"}}},"key":"X72nittvbd"}],"key":"pyD530ZD2N"}],"key":"ST9ifo24wu"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"important","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"The two shading sections are alternatives","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"l9uhMo8kjf"}],"key":"O6FH2lIbIq"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ipjdMebD0X"},{"type":"inlineCode","value":"xarray-spatial","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"KXPfCRLyhx"},{"type":"text","value":" hillshade and this ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xAHktdFdTB"},{"type":"inlineCode","value":"LightSource","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"VMM9fK4iHp"},{"type":"text","value":" view are two separate ways to render relief, not a chain. ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"EiN0rNuRZd"},{"type":"inlineCode","value":"LightSource.shade","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"tYLQr2vk8K"},{"type":"text","value":" computes its own hillshade internally and blends it with the colormap, so the earlier ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"OAtZuLpMpJ"},{"type":"inlineCode","value":"shaded","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aw9SW2xCdB"},{"type":"text","value":" array is not an input here. Reach for ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"L5DHKncbVy"},{"type":"inlineCode","value":"xarray-spatial","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"LVu9pptjwz"},{"type":"text","value":"’s ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"VClmYjmJMi"},{"type":"inlineCode","value":"hillshade","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"nwHIs1IhCc"},{"type":"text","value":" when you need the relief as reusable data, such as saving it as its own raster or scaling across large Dask-backed arrays; reach for ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"c8O6LMyWcH"},{"type":"inlineCode","value":"LightSource.shade","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ucJYDRCdOF"},{"type":"text","value":" when you just want the finished color-and-relief figure.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"J7bdr8iTDK"}],"key":"RDSXbNxZS9"}],"key":"bcATQyJUog"}],"key":"K6qQSMWBss"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A reusable function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"udnoEAfzxK"}],"identifier":"a-reusable-function","label":"A reusable function","html_id":"a-reusable-function","implicit":true,"key":"HPv32zXUYy"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The same three steps, load, shade, and plot, apply to any single-band bathymetry raster. We wrap them in one function and apply it to a second survey, Point Cloates.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NFnAmPhIfc"}],"key":"O2Vu6lo338"}],"key":"upb0InXMam"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def plot_shaded_relief(path, title, azimuth=315, altitude=45, vert_exag=5, cmap=\"viridis\"):\n    \"\"\"Load a single-band raster with rioxarray and plot color-shaded relief.\"\"\"\n    da = rioxarray.open_rasterio(path, masked=True).squeeze()\n\n    ls = LightSource(azdeg=azimuth, altdeg=altitude)\n    dx, dy = da.rio.resolution()\n    rgb = ls.shade(\n        da.values, cmap=plt.get_cmap(cmap), vert_exag=vert_exag,\n        dx=abs(dx), dy=abs(dy), blend_mode=\"soft\",\n    )\n\n    left, bottom, right, top = da.rio.bounds()\n    fig, ax = plt.subplots(figsize=(9, 7), constrained_layout=True)\n    ax.imshow(rgb, extent=(left, right, bottom, top), origin=\"upper\")\n\n    norm = Normalize(vmin=float(da.min()), vmax=float(da.max()))\n    cbar = fig.colorbar(ScalarMappable(norm=norm, cmap=cmap), ax=ax, shrink=0.85)\n    cbar.set_label(\"Bathymetry (m)\")\n\n    ax.set_title(title)\n    ax.set_xlabel(\"Easting (m)\")\n    ax.set_ylabel(\"Northing (m)\")\n    ax.xaxis.set_major_formatter(formatter)\n    ax.yaxis.set_major_formatter(formatter)\n    return da","key":"KOXFOjizD3"},{"type":"outputs","id":"3eKmRWtSYYCj1nnE2D-wr","children":[],"key":"s95Sh1IGTE"}],"key":"b32qEM3NLn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Applying to another survey","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FSy9VVBpUq"}],"identifier":"applying-to-another-survey","label":"Applying to another survey","html_id":"applying-to-another-survey","implicit":true,"key":"RE6e07Qq8Z"}],"key":"bvj23CXZNY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"pc_bathy = plot_shaded_relief(\"../data/pc_bathy.tif\", \"Point Cloates color-shaded relief\")\nplt.show()","key":"DbcBsrz6gC"},{"type":"outputs","id":"FZ7RbaIIesipWC7rh2wNg","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 900x700 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"75978bd231c676d548aa39f6605f8a32","path":"/geomorphology-cookbook/build/75978bd231c676d548aa39f6605f8a32.png"}}},"key":"HFoMWkOU3E"}],"key":"nE2hqQ2z3E"}],"key":"jHyv84qzpB"}],"key":"UrzEPs8hBC"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introduction to rasterio","url":"/notebooks/rasterio-intro","group":"Introduction"},"next":{"title":"Metadata and resources for the data story","url":"/notebooks/metadata","group":"Data story"}}},"domain":"http://localhost:3000"}