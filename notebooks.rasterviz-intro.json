":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(10, 8), constrained_layout=True)\n\n# base layer: depth in color\nbathy.plot(ax=ax, cmap=\"viridis\", cbar_kwargs={\"label\": \"Depth (m)\"})\n\n# overlay: the (exaggerated) hillshade from above, grayscale and semi-transparent\nshaded.plot(ax=ax, cmap=\"gray\", alpha=0.45, add_colorbar=False)\n\nax.set_title(f\"Gifford color-shaded relief (hillshade overlay, vert_exag={vert_exag})\")\nax.set_xlabel(\"Easting (m)\")\nax.set_ylabel(\"Northing (m)\")\nax.xaxis.set_major_formatter(formatter)\nax.yaxis.set_major_formatter(formatter)\nax.set_aspect(\"equal\")\nplt.show()","key":"yTv2lzRzLV"},{"type":"outputs","id":"qyRtHOHCMwn8VLJL0FhHe","children":[],"key":"Zqm29RJs36"}],"key":"TLrBfReV6n"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"inlineCode","value":"LightSource","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XgdDW9YRmu"},{"type":"text","value":" is another way to do this","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ai8NG6NsMn"}],"key":"DD0hFrvR91"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We built the color-shaded relief in two explicit steps: compute the hillshade as reusable data with ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Kr4hvN1nTU"},{"type":"inlineCode","value":"xarray-spatial","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SobdAQ8rth"},{"type":"text","value":", then overlay it on the colormap with ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"l9iSDnFFmB"},{"type":"inlineCode","value":"alpha","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"KkreNXsZkE"},{"type":"text","value":". Keeping 