.plot(ax=ax, cmap=\"gray\", alpha=alpha, add_colorbar=False)\n\n    ax.set_title(title)\n    ax.set_xlabel(\"Easting (m)\")\n    ax.set_ylabel(\"Northing (m)\")\n    ax.xaxis.set_major_formatter(formatter)\n    ax.yaxis.set_major_formatter(formatter)\n    ax.set_aspect(\"equal\")\n    return da","key":"Zmx7tZyBIL"},{"type":"outputs","id":"L_VyylejMshqOoZB-UhTT","children":[],"key":"YbC1BFooDB"}],"key":"it12l1XDqc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Applying to another survey","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bC2cLDyESJ"}],"identifier":"applying-to-another-survey","label":"Applying to another survey","html_id":"applying-to-another-survey","implicit":true,"key":"ltGUwR0wqh"}],"key":"PKQPfePMAH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"pc_bathy = plot_shaded_relief(\"../data/pc_bathy.tif\", \"Point Cloates color-shaded relief\")\nplt.show()","key":"itMysPSk10"},{"type":"outputs","id":"EHXMT4p-xZBxe6iimCZUb","children":[],"key":"BIZUG6DrhN"}],"key":"D5tjvfj3aZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KGeCCaEY3Q"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"OEk1tIYF59"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"rasterio is the workhorse for reading and writing georeferenced grids. A raster is an array paired with a CRS and an affine transform: the array holds the values, the CRS says where on Earth they sit, and the transform ties pixels to coordinate